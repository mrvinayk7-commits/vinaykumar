# Job Search Agent - Environment Variables
# Copy this file to .env and fill in your API keys

# SerpAPI key for Google Jobs search (https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# RapidAPI key for LinkedIn/Indeed APIs (https://rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# OpenAI API key for AI matching (https://platform.openai.com)
OPENAI_API_KEY=your_openai_key_here

# Email notifications (optional)
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_SENDER_PASSWORD=your-app-password
SMTP_RECIPIENT_EMAIL=your-email@gmail.com
